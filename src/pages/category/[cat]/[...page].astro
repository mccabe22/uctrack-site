---
// News category archives, 12 stories per page.
import NewsArchive from '../../../components/NewsArchive.astro';
import { getPosts } from '../../../lib/news.js';
import { filterCats } from '../../../lib/newsCats.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = filterCats(posts);
  const categories = [...new Map(posts.flatMap((p) => p.categories).map((c) => [c.slug, c])).values()];
  const out = [];
  for (const cat of categories) {
    const list = posts.filter((p) => p.categories.some((c) => c.slug === cat.slug));
    const total = Math.max(1, Math.ceil(list.length / 12));
    for (let n = 1; n <= total; n++) {
      out.push({ params: { cat: cat.slug, page: n === 1 ? undefined : `page/${n}` }, props: { cat, cats, n, total, items: list.slice((n - 1) * 12, n * 12) } });
    }
  }
  return out;
}
const { cat, cats, n, total, items } = Astro.props;
---
<NewsArchive heading={`Category: <span>${cat.name.replace(/&/g, '&amp;')}</span>`} base={`/category/${cat.slug}/`} n={n} total={total} items={items}
  cats={cats} activeCat={cat.slug === 'all-posts' ? '' : cat.slug}
  title={`${cat.name}${n > 1 ? ` – Page ${n}` : ''} – Union Catholic Cross Country | Track + Field`}
  description={`Union Catholic Cross Country and Track & Field news: ${cat.name}.`}
  bodyClass={`archive category category-${cat.slug} wp-custom-logo wp-embed-responsive wp-theme-uc-championship`} />
