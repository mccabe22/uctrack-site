---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found – Union Catholic Cross Country | Track + Field" path="/404/" noindex
      bodyClass="error404 wp-custom-logo wp-embed-responsive wp-theme-uc-championship">
  <main id="primary" class="site-main inner-page">
    <section class="inner-hero inner-hero--compact">
      <div class="inner-hero__overlay"></div>
      <div class="site-shell inner-hero__content"><h1>Page not found</h1></div>
    </section>
    <section class="section inner-content-section">
      <div class="site-shell article-shell">
        <article class="article article--page"><div class="article__content entry-content">
          <p>The page you were looking for has moved or no longer exists.</p>
          <p><a class="button" href="/">Home</a> <a class="button button--outline" href="/scheduleresults/">Schedule + Results</a> <a class="button button--outline" href="/school-records/">School Records</a> <a class="button button--outline" href="/category/all-posts/">News</a></p>
        </div></article>
      </div>
    </section>
  </main>
</Base>
