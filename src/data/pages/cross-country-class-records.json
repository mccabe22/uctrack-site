                    Girls Records                    </button>\n<button aria-selected=\"false\" class=\"ucrl-tab\" data-tab=\"boys-records\" role=\"tab\" type=\"button\">\n                        Boys Records                    </button>\n<button aria-selected=\"false\" class=\"ucrl-tab\" data-tab=\"girls-team-average\" role=\"tab\" type=\"button\">\n                        Girls Team Average                    </button>\n<button aria-selected=\"false\" class=\"ucrl-tab\" data-tab=\"boys-team-average\" role=\"tab\" type=\"button\">\n                        Boys Team Average                    </button>\n</div>\n<label class=\"ucrl-search\">\n<span class=\"screen-reader-text\">Search this record book</span>\n<svg aria-hidden=\"true\" viewbox=\"0 0 24 24\"><path d=\"m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"2\"></path></svg>\n<input aria-label=\"Search records\" autocomplete=\"off\" class=\"ucrl-search-input\" placeholder=\"Search event, athlete, year…\" type=\"search\"/>\n</label>\n</div>\n<div aria-live=\"polite\" class=\"ucrl-status\"></div>\n<div class=\"ucrl-panel\" data-active-tab=\"girls-records\"><!--LIVE:records--></div>\n<div class=\"ucrl-empty\" hidden=\"\">No matching records found.</div>\n<script>\n        (function(){\n            var root = document.currentScript && document.currentScript.closest('.ucrl-shell');\n            if (!root || root.getAttribute('data-ucrl-search-fallback') === '1') return;\n            root.setAttribute('data-ucrl-search-fallback','1');\n            var input = root.querySelector('.ucrl-search-input');\n            var panel = root.querySelector('.ucrl-panel');\n            var empty = root.querySelector('.ucrl-empty');\n            if (!input || !panel) return;\n\n            function show(el, yes){\n                if (!el) return;\n                el.style.setProperty('display', yes ? '' : 'none', yes ? '' : 'important');\n                if (yes) {\n                    el.classList.remove('ucrl-filter-hidden');\n                    el.removeAttribute('aria-hidden');\n                } else {\n                    el.classList.add('ucrl-filter-hidden');\n                    el.setAttribute('aria-hidden','true');\n                }\n            }\n\n            function filter(){\n                var q=(input.value||'').toLowerCase().trim();\n                var items=Array.prototype.slice.call(panel.querySelectorAll('.ucrl-filter-item'));\n                var visible=0;\n\n                if (!q){\n                    Array.prototype.forEach.call(panel.querySelectorAll('.ucrl-filter-item,.ucrl-data-row'), function(el){ show(el,true); });\n                    if (empty) { empty.hidden=true; show(empty,false); }\n                    return;\n                }\n\n                if (items.length){\n                    items.forEach(function(item){\n                        var rows=Array.prototype.slice.call(item.querySelectorAll('.ucrl-data-row'));\n                        if (rows.length){\n                            var heading=(item.querySelector('h3') ? item.querySelector('h3').textContent : (item.getAttribute('data-search')||''));\n                            var headingMatch=(heading||'').toLowerCase().indexOf(q)!==-1;\n                            var matched=0;\n                            rows.forEach(function(row){\n                                var hay=(row.getAttribute('data-search')||row.textContent||'').toLowerCase();\n                                var ok=headingMatch || hay.indexOf(q)!==-1;\n                                show(row,ok);\n                                if(ok) matched++;\n                            });\n                            show(item,matched>0);\n                            if(matched>0) visible++;\n                        } else {\n                            var hay=(item.getAttribute('data-search')||item.textContent||'').toLowerCase();\n                            var ok=hay.indexOf(q)!==-1;\n                            show(item,ok);\n                            if(ok) visible++;\n                        }\n                    });\n                } else {\n                    var rows=Array.prototype.slice.call(panel.querySelectorAll('.ucrl-data-row'));\n                    rows.forEach(function(row){\n                        var hay=(row.getAttribute('data-search')||row.textContent||'').toLowerCase();\n                        var ok=hay.indexOf(q)!==-1;\n                        show(row,ok);\n                        if(ok) visible++;\n                    });\n                }\n                if(empty){\n                    empty.hidden=visible>0;\n                    show(empty,visible===0);\n                }\n            }\n\n            input.addEventListener('input',filter);\n            input.addEventListener('keyup',filter);\n            input.addEventListener('change',filter);\n            input.addEventListener('search',filter);\n\n            // Re-run after lazy-loaded tabs replace panel HTML.\n            if (window.MutationObserver) {\n                new MutationObserver(function(){ filter(); }).observe(panel,{childList:true,subtree:false});\n            }\n        })();\n        </script>\n</section>\n</div>\n</article>\n</div>\n</section>\n"}