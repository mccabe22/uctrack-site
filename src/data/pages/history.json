{"path": "/history/", "title": "History – Union Catholic Cross Country | Track + Field", "description": "Union Catholic Track & Field + Cross Country A Legacy Built to Last Since Union Catholic opened in 1964, generations of Vikings have built a program defined by…", "ogImage": "/wp-content/uploads/2026/07/cropped-cropped-uctflogoheader.png", "ogType": "website", "bodyClass": "wp-singular page-template-default page page-id-15211 wp-custom-logo wp-embed-responsive wp-theme-uc-championship", "mainId": "primary", "mainClass": "site-main inner-page", "live": {}, "styles": ["main.css", "uc-refresh.css"], "headInline": [], "scripts": [{"src": "/assets/main.js"}], "html": "\n<section class=\"inner-hero\" style=\"\">\n<div class=\"inner-hero__overlay\"></div>\n<div class=\"site-shell inner-hero__content\">\n<h1>History</h1>\n<span aria-hidden=\"true\" class=\"inner-hero__rule\"></span>\n</div>\n</section>\n<section class=\"section inner-content-section\">\n<div class=\"site-shell article-shell\">\n<article class=\"article article--page post-15211 page type-page status-publish hentry\">\n<div class=\"article__content entry-content\"><style>\n/* Union Catholic History Page */\n.uc-history{\n  --uc-navy:#071a33;\n  --uc-navy-2:#0d2a50;\n  --uc-gold:#f2b632;\n  --uc-gold-soft:#fff4cf;\n  --uc-ink:#142033;\n  --uc-muted:#667085;\n  --uc-line:#dfe5ec;\n  --uc-bg:#f7f9fc;\n  --uc-white:#ffffff;\n  color:var(--uc-ink);\n  font-family:inherit;\n}\n.uc-history *{box-sizing:border-box}\n.uc-history a{text-decoration:none}\n.uc-history-shell{width:min(1180px,calc(100% - 36px));margin:0 auto}\n.uc-history-hero{\n  position:relative;\n  overflow:hidden;\n  margin:0 0 34px;\n  border-radius:26px;\n  padding:clamp(44px,7vw,92px) clamp(24px,6vw,76px);\n  background:\n    radial-gradient(circle at 88% 18%,rgba(242,182,50,.24),transparent 28%),\n    linear-gradient(135deg,var(--uc-navy) 0%,var(--uc-navy-2) 100%);\n  color:var(--uc-white);\n  box-shadow:0 24px 60px rgba(7,26,51,.18);\n}\n.uc-history-hero:after{\n  content:\"UC\";\n  position:absolute;\n  right:-18px;\n  bottom:-72px;\n  font-size:clamp(150px,24vw,340px);\n  font-weight:900;\n  line-height:1;\n  letter-spacing:-.08em;\n  color:rgba(255,255,255,.035);\n  pointer-events:none;\n}\n.uc-history-kicker{\n  margin:0 0 12px;\n  color:var(--uc-gold);\n  font-size:12px;\n  font-weight:900;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n}\n.uc-history-hero h2{\n  position:relative;\n  z-index:1;\n  max-width:820px;\n  margin:0;\n  color:#fff;\n  font-size:clamp(38px,7vw,78px);\n  line-height:.96;\n  letter-spacing:-.045em;\n  text-transform:uppercase;\n}\n.uc-history-hero p{\n  position:relative;\n  z-index:1;\n  max-width:780px;\n  margin:24px 0 0;\n  color:rgba(255,255,255,.84);\n  font-size:clamp(17px,2vw,21px);\n  line-height:1.65;\n}\n.uc-history-stats{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:14px;\n  margin:0 0 58px;\n}\n.uc-history-stat{\n  padding:24px 18px;\n  border:1px solid var(--uc-line);\n  border-radius:18px;\n  background:#fff;\n  text-align:center;\n  box-shadow:0 10px 30px rgba(17,34,68,.06);\n}\n.uc-history-stat strong{\n  display:block;\n  color:var(--uc-navy);\n  font-size:clamp(30px,4vw,47px);\n  line-height:1;\n  letter-spacing:-.04em;\n}\n.uc-history-stat span{\n  display:block;\n  margin-top:8px;\n  color:var(--uc-muted);\n  font-size:12px;\n  font-weight:900;\n  line-height:1.3;\n  letter-spacing:.075em;\n  text-transform:uppercase;\n}\n.uc-history-section{margin:0 0 64px}\n.uc-history-heading{\n  display:flex;\n  align-items:flex-end;\n  justify-content:space-between;\n  gap:22px;\n  margin-bottom:28px;\n}\n.uc-history-heading>div{max-width:760px}\n.uc-history-heading .uc-history-kicker{margin-bottom:8px}\n.uc-history-heading h2{\n  margin:0;\n  color:var(--uc-navy);\n  font-size:clamp(30px,5vw,52px);\n  line-height:1;\n  letter-spacing:-.04em;\n  text-transform:uppercase;\n}\n.uc-history-heading p{\n  max-width:760px;\n  margin:14px 0 0;\n  color:var(--uc-muted);\n  font-size:17px;\n  line-height:1.7;\n}\n.uc-history-timeline{\n  position:relative;\n  display:grid;\n  gap:24px;\n}\n.uc-history-timeline:before{\n  content:\"\";\n  position:absolute;\n  left:50%;\n  top:0;\n  bottom:0;\n  width:2px;\n  transform:translateX(-1px);\n  background:linear-gradient(var(--uc-gold),rgba(242,182,50,.18));\n}\n.uc-history-era{\n  position:relative;\n  width:calc(50% - 34px);\n  padding:28px;\n  border:1px solid var(--uc-line);\n  border-radius:20px;\n  background:#fff;\n  box-shadow:0 14px 34px rgba(17,34,68,.07);\n}\n.uc-history-era:nth-child(odd){justify-self:start}\n.uc-history-era:nth-child(even){justify-self:end}\n.uc-history-era:before{\n  content:\"\";\n  position:absolute;\n  top:31px;\n  width:14px;\n  height:14px;\n  border:4px solid #fff;\n  border-radius:50%;\n  background:var(--uc-gold);\n  box-shadow:0 0 0 2px var(--uc-gold);\n}\n.uc-history-era:nth-child(odd):before{right:-42px}\n.uc-history-era:nth-child(even):before{left:-42px}\n.uc-history-year{\n  display:inline-flex;\n  margin-bottom:12px;\n  padding:7px 11px;\n  border-radius:999px;\n  background:var(--uc-gold-soft);\n  color:#8a5d00;\n  font-size:12px;\n  font-weight:900;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n}\n.uc-history-era h3{\n  margin:0 0 10px;\n  color:var(--uc-navy);\n  font-size:25px;\n  line-height:1.1;\n  letter-spacing:-.025em;\n}\n.uc-history-era p{\n  margin:0;\n  color:#526070;\n  font-size:16px;\n  line-height:1.7;\n}\n.uc-history-standard{\n  position:relative;\n  overflow:hidden;\n  margin:66px 0;\n  padding:clamp(36px,7vw,78px);\n  border-radius:26px;\n  background:var(--uc-navy);\n  color:#fff;\n}\n.uc-history-standard:before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background:linear-gradient(120deg,rgba(242,182,50,.13),transparent 45%);\n  pointer-events:none;\n}\n.uc-history-standard-inner{position:relative;z-index:1;max-width:900px}\n.uc-history-standard .uc-history-kicker{color:var(--uc-gold)}\n.uc-history-standard h2{\n  margin:0 0 26px;\n  color:#fff;\n  font-size:clamp(36px,6vw,68px);\n  line-height:.98;\n  letter-spacing:-.04em;\n  text-transform:uppercase;\n}\n.uc-history-mantra{\n  display:grid;\n  gap:3px;\n  margin:0 0 28px;\n  font-size:clamp(22px,3.2vw,35px);\n  font-weight:900;\n  line-height:1.16;\n  text-transform:uppercase;\n}\n.uc-history-mantra span:nth-child(even){color:var(--uc-gold)}\n.uc-history-standard p{\n  max-width:760px;\n  margin:0;\n  color:rgba(255,255,255,.78);\n  font-size:18px;\n  line-height:1.7;\n}\n.uc-history-values{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:18px;\n}\n.uc-history-value{\n  min-height:230px;\n  padding:28px;\n  border:1px solid var(--uc-line);\n  border-radius:20px;\n  background:#fff;\n  box-shadow:0 12px 32px rgba(17,34,68,.06);\n}\n.uc-history-value-num{\n  display:block;\n  margin-bottom:40px;\n  color:var(--uc-gold);\n  font-size:13px;\n  font-weight:900;\n  letter-spacing:.12em;\n}\n.uc-history-value h3{\n  margin:0 0 10px;\n  color:var(--uc-navy);\n  font-size:24px;\n  letter-spacing:-.02em;\n}\n.uc-history-value p{\n  margin:0;\n  color:var(--uc-muted);\n  font-size:16px;\n  line-height:1.65;\n}\n.uc-history-next{\n  margin-top:66px;\n  padding:clamp(34px,6vw,66px);\n  border:1px solid #efd995;\n  border-radius:26px;\n  background:linear-gradient(145deg,#fff9e9,#fff);\n  text-align:center;\n}\n.uc-history-next .uc-history-kicker{color:#8a5d00}\n.uc-history-next h2{\n  margin:0;\n  color:var(--uc-navy);\n  font-size:clamp(36px,6vw,64px);\n  line-height:1;\n  letter-spacing:-.04em;\n  text-transform:uppercase;\n}\n.uc-history-next>p{\n  max-width:760px;\n  margin:18px auto 0;\n  color:#596579;\n  font-size:18px;\n  line-height:1.7;\n}\n.uc-history-standards{\n  display:flex;\n  flex-wrap:wrap;\n  justify-content:center;\n  gap:8px 18px;\n  max-width:900px;\n  margin:28px auto 0;\n  color:var(--uc-navy);\n  font-size:14px;\n  font-weight:900;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n}\n.uc-history-standards span:after{\n  content:\"•\";\n  margin-left:18px;\n  color:var(--uc-gold);\n}\n.uc-history-standards span:last-child:after{display:none}\n.uc-history-cta{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:14px;\n  margin-top:30px;\n}\n.uc-history-cta a{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  min-height:68px;\n  padding:18px 20px;\n  border-radius:14px;\n  background:var(--uc-navy);\n  color:#fff;\n  font-size:13px;\n  font-weight:900;\n  letter-spacing:.055em;\n  text-transform:uppercase;\n  transition:transform .2s ease,background .2s ease;\n}\n.uc-history-cta a:hover{\n  transform:translateY(-2px);\n  background:var(--uc-navy-2);\n}\n.uc-history-cta a span{\n  color:var(--uc-gold);\n  font-size:20px;\n}\n@media (max-width:900px){\n  .uc-history-stats{grid-template-columns:repeat(2,1fr)}\n  .uc-history-values{grid-template-columns:1fr}\n  .uc-history-value{min-height:0}\n  .uc-history-value-num{margin-bottom:24px}\n  .uc-history-cta{grid-template-columns:1fr}\n}\n@media (max-width:720px){\n  .uc-history-shell{width:min(100% - 24px,1180px)}\n  .uc-history-hero{border-radius:18px}\n  .uc-history-timeline:before{left:9px;transform:none}\n  .uc-history-era,\n  .uc-history-era:nth-child(odd),\n  .uc-history-era:nth-child(even){\n    width:calc(100% - 32px);\n    justify-self:end;\n  }\n  .uc-history-era:nth-child(odd):before,\n  .uc-history-era:nth-child(even):before{\n    left:-30px;\n    right:auto;\n  }\n  .uc-history-heading{display:block}\n  .uc-history-standard,\n  .uc-history-next{border-radius:18px}\n}\n@media (max-width:480px){\n  .uc-history-stats{grid-template-columns:1fr 1fr;gap:10px}\n  .uc-history-stat{padding:20px 10px}\n  .uc-history-stat span{font-size:10px}\n  .uc-history-era{padding:22px}\n  .uc-history-next{padding:30px 20px}\n  .uc-history-standards{display:grid;gap:8px}\n  .uc-history-standards span:after{display:none}\n}\n</style>\n<div class=\"uc-history\">\n<div class=\"uc-history-shell\">\n<section class=\"uc-history-hero\">\n<p class=\"uc-history-kicker\">Union Catholic Track &amp; Field + Cross Country</p>\n<h2>A Legacy Built to Last</h2>\n<p>\n        Since Union Catholic opened in 1964, generations of Vikings have built a program defined by commitment, character, teamwork and competitive excellence. What began as a school athletic program has grown into one of New Jersey’s most accomplished programs and a nationally recognized home for championship track &amp; field and cross country.\n      </p>\n</section>\n<section aria-label=\"Program achievements\" class=\"uc-history-stats\">\n<div class=\"uc-history-stat\">\n<strong>64</strong><br/>\n<span>State Team Championships</span>\n</div>\n<div class=\"uc-history-stat\">\n<strong>8</strong><br/>\n<span>National Records</span>\n</div>\n<div class=\"uc-history-stat\">\n<strong>130+</strong><br/>\n<span>National Champions</span>\n</div>\n<div class=\"uc-history-stat\">\n<strong>300+</strong><br/>\n<span>All-Americans</span>\n</div>\n</section>\n<section class=\"uc-history-section\">\n<div class=\"uc-history-heading\">\n<div>\n<p class=\"uc-history-kicker\">The Story</p>\n<h2>Built One Generation at a Time</h2>\n<p>\n            The championships are part of the story. The larger story is how each generation raised the standard for the next.\n          </p>\n</div>\n</div>\n<div class=\"uc-history-timeline\">\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">1964</span>\n<h3>The Foundation</h3>\n<p>\n            Union Catholic High School opens its doors, with athletics becoming an important part of the school’s identity. Track &amp; field and cross country begin building a culture rooted in hard work, sportsmanship and school pride.\n          </p>\n</article>\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">The Modern Era</span>\n<h3>A Championship Culture Takes Shape</h3>\n<p>\n            The program develops around a complete student-athlete model: faith, character, teamwork, leadership, academic success and competitive excellence. Winning matters, but so does how athletes represent their team and school.\n          </p>\n</article>\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">2013–2014</span>\n<h3>National Breakthrough</h3>\n<p>\n            Back-to-back national indoor team championships establish Union Catholic on the national stage and signal that the program’s ambitions extend far beyond New Jersey.\n          </p>\n</article>\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">2015–2020</span>\n<h3>Sustained Excellence</h3>\n<p>\n            State, county and relay championships begin stacking across seasons. The program’s depth becomes a defining strength, with complete teams competing at a championship level year after year.\n          </p>\n</article>\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">2021–2024</span>\n<h3>A New National Standard</h3>\n<p>\n            Cross country, indoor and outdoor teams continue to win at the state level while UC athletes produce national records, national championships, All-American performances and appearances on the sport’s biggest stages.\n          </p>\n</article>\n<article class=\"uc-history-era\">\n<span class=\"uc-history-year\">Today</span>\n<h3>The Standard Keeps Rising</h3>\n<p>\n            With 64 state team championships, eight national records and generations of national champions and All-Americans, Union Catholic continues to pursue the same goal: leave the program better than you found it.\n          </p>\n</article></div>\n</section>\n<section class=\"uc-history-standard\">\n<div class=\"uc-history-standard-inner\">\n<p class=\"uc-history-kicker\">Home of Champions</p>\n<h2>The Standard Is Daily</h2>\n<div aria-label=\"Program standard\" class=\"uc-history-mantra\">\n<span>Every workout.</span><br/>\n<span>Every practice.</span><br/>\n<span>Every race.</span><br/>\n<span>Every teammate.</span><br/>\n<span>Every season.</span>\n</div>\n<p>\n          “Home of Champions” is more than a slogan. It is the expectation that the little things are done the right way, that teammates support one another, and that every Viking understands they are part of something bigger than themselves.\n        </p>\n</div>\n</section>\n<section class=\"uc-history-section\">\n<div class=\"uc-history-heading\">\n<div>\n<p class=\"uc-history-kicker\">Beyond The Results</p>\n<h2>More Than Championships</h2>\n<p>\n            Records and trophies document achievement. The people, relationships and opportunities created by the program are the lasting legacy.\n          </p>\n</div>\n</div>\n<div class=\"uc-history-values\">\n<article class=\"uc-history-value\">\n<span class=\"uc-history-value-num\">01</span>\n<h3>The Athletes</h3>\n<p>\n            Vikings have continued from Union Catholic to the NCAA, national championships, professional opportunities and the Olympic stage.\n          </p>\n</article>\n<article class=\"uc-history-value\">\n<span class=\"uc-history-value-num\">02</span>\n<h3>The People</h3>\n<p>\n            Alumni have become coaches, teachers, professionals, military officers, business leaders and community leaders — carrying the lessons of the program far beyond competition.\n          </p>\n</article>\n<article class=\"uc-history-value\">\n<span class=\"uc-history-value-num\">03</span>\n<h3>The Family</h3>\n<p>\n            Teammates, coaches and families create relationships that often last long after the final race. Every new athlete becomes part of that continuing story.\n          </p>\n</article></div>\n</section>\n<section class=\"uc-history-next\">\n<p class=\"uc-history-kicker\">The Tradition Continues</p>\n<h2>The Next Chapter</h2>\n<p>\n        Every season brings new goals, new athletes and another opportunity to add to Union Catholic’s history. The names change. The standard does not.\n      </p>\n<div class=\"uc-history-standards\">\n<span>Compete With Passion</span><br/>\n<span>Lead With Humility</span><br/>\n<span>Honor The Team</span><br/>\n<span>Pursue Greatness</span>\n</div>\n<div class=\"uc-history-cta\">\n<a href=\"/tradition-of-excellence/\">Explore The Tradition <span>→</span></a><br/>\n<a href=\"/alumni/\">Meet Our Alumni <span>→</span></a><br/>\n<a href=\"/school-records/\">View School Records <span>→</span></a>\n</div>\n</section></div>\n</div>\n</div>\n</article>\n</div>\n</section>\n"}