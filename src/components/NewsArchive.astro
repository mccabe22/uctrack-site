---
// Paged list of news cards (used by /news/ and /category/<name>/).
import Base from '../layouts/Base.astro';
import { esc } from '../lib/util.js';

const { heading, base, n, total, items, cats = [], activeCat = '', title, description, bodyClass } = Astro.props;
const href = (i) => (i === 1 ? base : `${base}page/${i}/`);
const shown = [...new Set([1, n - 1, n, n + 1, total])].filter((i) => i >= 1 && i <= total).sort((a, b) => a - b);
let nav = '';
if (n > 1) nav += `<a class="prev page-numbers" href="${href(n - 1)}">← PREVIOUS</a>\n`;
shown.forEach((i, idx) => {
  if (idx && i - shown[idx - 1] > 1) nav += '<span class="page-numbers dots">…</span>\n';
  nav += i === n ? `<span aria-current="page" class="page-numbers current">${i}</span>\n` : `<a class="page-numbers" href="${href(i)}">${i}</a>\n`;
});
if (n < total) nav += `<a class="next page-numbers" href="${href(n + 1)}">NEXT →</a>`;
const card = (p) => {
  const img = p.image?.card
    ? `<img${p.image.card.w ? ` width="${p.image.card.w}" height="${p.image.card.h}"` : ''} src="${esc(p.image.card.src)}" class="attachment-uc-card size-uc-card wp-post-image" alt="${esc(p.image.alt)}" decoding="async" loading="lazy" />`
    : '<span>UC</span>';
  return `<article class="news-card news-card--archive ${esc(p.classList)}"><a class="news-card__image" href="/${p.slug}/" aria-label="${esc(p.title.replace(/<[^>]*>/g, ''))}">${img}</a><div class="news-card__body"><div class="news-card__meta"><time>${esc(p.dateText)}</time><span>${esc(p.categories.find((c) => c.slug !== 'all-posts')?.name || p.categories[0]?.name || '')}</span></div><h2><a href="/${p.slug}/">${p.title}</a></h2>${p.excerpt}<a class="text-link" href="/${p.slug}/">READ STORY →</a></div></article>`;
};
---
<Base title={title} description={description} path={href(n)} bodyClass={bodyClass}>
  <main id="primary" class="site-main inner-page">
    <section class="inner-hero inner-hero--compact">
      <div class="inner-hero__overlay"></div>
      <div class="site-shell inner-hero__content"><h1 set:html={heading}></h1></div>
    </section>
    <section class="section section--muted archive-section">
      <div class="site-shell">
        {cats.length > 0 && (
          <nav class="uc-news-cats" aria-label="News categories">
            <a href="/news/" class={activeCat === '' ? 'is-active' : undefined}>All News</a>
            {cats.map((c) => <a href={`/category/${c.slug}/`} class={activeCat === c.slug ? 'is-active' : undefined}>{c.name}</a>)}
          </nav>
        )}
        <div class="archive-grid archive-grid--polished" set:html={items.map(card).join('')}></div>
        {total > 1 && (
          <nav class="navigation pagination" aria-label="Posts pagination">
            <h2 class="screen-reader-text">Posts pagination</h2>
            <div class="nav-links" set:html={nav}></div>
          </nav>
        )}
      </div>
    </section>
  </main>
</Base>
